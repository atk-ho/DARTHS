{
  "rules": {
    "liveMatches": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-f0-9]{36}$/)",
        ".write": "auth != null && $room.matches(/^[a-f0-9]{36}$/) && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.child('owner').val() === auth.uid && (!newData.exists() || newData.child('owner').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['owner','updatedAt','game','iv']) && newData.child('owner').val() === auth.uid && newData.child('updatedAt').isNumber() && newData.child('iv').isNumber() && newData.child('iv').val() >= 0 && newData.child('game').hasChildren(['participants','points','current'])",
        "owner": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "iv": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "game": {
          ".validate": "newData.hasChildren(['participants','points','current'])"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
